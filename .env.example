# ---- PostgreSQL (local dev uses port 5433 with `npm run db:start`) ----
DATABASE_URL=postgres://postgres:postgres@localhost:5433/stagepass

# ---- Express API ----
API_PORT=4000
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d
HOLD_MINUTES_DEFAULT=10
# Browser origins allowed by CORS (comma separated) — add your deployed frontend URL.
FRONTEND_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
# Set COOKIE_SAMESITE=none and COOKIE_SECURE=true when frontend and API are on different sites.
COOKIE_SAMESITE=lax
COOKIE_SECURE=false
# Optional: where multer writes uploads (use a mounted disk in production).
# UPLOAD_DIR=/var/data/uploads
# Boot-time schema setup for fresh deployments (render.yaml enables it).
# Idempotent: applies only pending migrations.
# DB_AUTO_MIGRATE=true
# First admin account, created at boot when both are set (password >= 8 chars).
# ADMIN_EMAIL=you@yourdomain.com
# ADMIN_PASSWORD=change-me-properly
# ADMIN_NAME=Your Name
# Gate staff account (role: scanner) — signs in at /login and validates tickets at /scan.
# SCANNER_EMAIL=scanner@yourdomain.com
# SCANNER_PASSWORD=change-me-properly
# SCANNER_NAME=Gate 1
# Insert the demo catalogue (3 venues, 6 events, seats, tiers) into an empty database.
# Runs once, only when there are no events yet. SEED_DEMO_DATA=false disables it.
# SEED_DEMO_DATA=true

# ---- Next.js frontend ----
API_URL=http://127.0.0.1:4000
NEXT_PUBLIC_API_URL=http://127.0.0.1:4000
